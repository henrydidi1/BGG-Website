# ==========================================================
# BrandGo.Global — environment variables (placeholders only)
# ==========================================================
# Copy this file to `.env.local` (already gitignored) and
# fill in the real values. Never commit `.env` or `.env.local`.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Lead recipient. Behind-the-scenes inbox that receives
# submissions from /api/contact. Do NOT publish this address
# on the public site; keep it server-side only.
CONTACT_TO_EMAIL=

# Verified sender identity, e.g.
#   "BrandGo.Global Website <website@brandgo.global>"
# Must be a domain verified inside Resend before delivery.
CONTACT_FROM_EMAIL=
